# =====================================================================
# 部署环境变量模板（M12）—— 复制为 .env 后填值：cp .env.example .env
# 真实 .env 被仓库根 .gitignore 的 `.env` 规则忽略，永不进 git；
# 本模板只有键名和生成方法，没有任何真实值。
# 权限纪律（§1.4）：chmod 600 .env
# =====================================================================

# ---- MySQL root 口令（compose 用它建库+健康检查+备份脚本共用）----
# 生成：openssl rand -base64 18
MYSQL_ROOT_PASSWORD=CHANGE-ME-STRONG-PASSWORD

# ---- Redis 口令（requirepass，§1.1 生产必须开）----
# 生成：openssl rand -base64 12
REDIS_PASS=CHANGE-ME-REDIS-PASSWORD

# ---- JWT 签名密钥：必须 >=32 字节（jjwt HS256 弱密钥闸门，M2 实现）----
# 生成：openssl rand -hex 32
BLOG_JWT_SECRET=REPLACE-WITH-64-HEX-CHARS

# ---- AI 主密钥（AES-256-GCM，加密 ai_config.api_key_cipher 落库）----
# 生成：openssl rand -hex 32
# 注意：换这把密钥=历史密文全部作废，需在后台重配模型 Key（风险表 R-06）
BLOG_AI_MASTER_KEY=REPLACE-WITH-64-HEX-CHARS

# ---- 内置模型开箱即用 Key（可选！）----
# 填了 -> BuiltinModelKeySeeder 首启自动加密导入 ai_config（答辩演示"开箱即用"）；
# 留空 -> 两行保持占位，管理员后台手工录入，系统其余功能不受影响（降级设计）。
BLOG_AI_KEY_DEEPSEEK=
BLOG_AI_KEY_QWEN=

# ---- 管理员初始口令（AdminBootstrapRunner 首启创建 admin；上线后立即改密）----
BLOG_ADMIN_PASSWORD=Admin@123
