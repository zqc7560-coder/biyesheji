<?xml version="1.0" encoding="UTF-8"?>
<!--
  =====================================================================
  个人博客系统 · 正式压力测试计划（M16 / 阶段七交付物）
  =====================================================================
  场景对应《部署与测试.md》§2 性能测试行的四个场景：
    TG-LIST      场景①：列表 200 并发 × 5min（目标 P95<300ms、错误率 0）
    TG-DETAIL    场景②：详情 200 并发（缓存命中路径，随机轮播 30 篇样本）
    TG-AI        场景③：AI 摘要 20 并发（暖缓存后全命中路径；M9 遗留的
                 "正式 JMeter 报告"就是本组产物）
    TG-AI-DEG    场景④：AI 降级路径 500 并发（ai_enabled=false 熔断后，
                 闸门在读正文/查配置/连上游之前 → 预期 <50ms、HTTP 403 code=4004）

  所有场景线程数都是 __P 属性，默认 0=跳过——由 run-load-test.sh 按场景开合，
  一个模板跑全部场景，避免多份 JMX 漂移。
  SETUP（登录取 token 进全局 props）与 PRIME（暖 AI 缓存 30 发）永远先跑：
    缓存键 = 标题+正文归一化哈希（AiCacheService.contentHash），PRIME 用的
    ai_bodies/*.json 与压测组随机取的同一批文件 → TG-AI 必全命中，
    这正是《部署与测试.md》§2 场景②的口径（测服务端开销，不测厂商时延）。
  降级组单独运行（runner 的 degraded 场景）：TG-AI 与其互斥，脚本会先翻 ai_enabled 开关。

  参数（jmeter -J）：
    host/port/proto   目标（默认 127.0.0.1:8080 http；走 Nginx 填 port=80）
    admin_user/admin_pass  管理端凭据（口令由 runner 从 .env 注入，本文件零明文）
    list_threads/list_duration/list_ramp        场景①  默认 200/300/10
    detail_threads/detail_duration/detail_ramp  场景②  默认 200/300/10
    ai_threads/ai_duration/ai_ramp              场景③  默认 20/120/5
    deg_threads/deg_loops/deg_ramp              场景④  默认 500/10/15
    id_min/id_max     详情轮播文章 id 区间（缺省 1..30 与 seed-loadtest-data.py
                      全新库实录一致；runner 总显式转发，缺省仅供手工单跑兜底。
                      历史值 13..42 是开发库口径，M16 实测会让 2/3 请求 404）
    ai_csv            请求体清单 CSV 路径
    ai_body_dir       请求体 JSON 目录
  =====================================================================
-->
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="blog-m16-load-test" enabled="true">
      <stringProp name="TestPlan.comments">M16 正式压测：四场景共用一个模板，参数全走 -J 属性</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
    </TestPlan>
    <hashTree>

      <!-- ========== SETUP：登录拿 JWT，写进全局 props 供各线程组共享 ==========
           线程组之间不共享 JMeterVariables，故用 JSR223 把 token 提升到
           JMeter properties（props），下游用 ${__P(ai_token)} 读取。 -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="SETUP-login" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">stopthread</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
      </ThreadGroup>
      <hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST /api/auth/login" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{"username":"${__P(admin_user,admin)}","password":"${__P(admin_pass,INVALID)}"}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
          <stringProp name="HTTPSampler.domain">${__P(host,127.0.0.1)}</stringProp>
          <stringProp name="HTTPSampler.port">${__P(port,8080)}</stringProp>
          <stringProp name="HTTPSampler.protocol">${__P(proto,http)}</stringProp>
          <stringProp name="HTTPSampler.path">/api/auth/login</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <stringProp name="HTTPSampler.connect_timeout">5000</stringProp>
          <stringProp name="HTTPSampler.response_timeout">30000</stringProp>
        </HTTPSamplerProxy>
        <hashTree>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Content-Type" enabled="true">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Content-Type</stringProp>
                <stringProp name="Header.value">application/json</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
          <JSONPostProcessor guiclass="TestBeanGUI" testclass="JSONPostProcessor" testname="extract token" enabled="true">
            <stringProp name="JSONPostProcessor.referenceNames">login_token</stringProp>
            <stringProp name="JSONPostProcessor.jsonPathExprs">$.data.token</stringProp>
            <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
            <stringProp name="JSONPostProcessor.defaultValues">NOTFOUND</stringProp>
          </JSONPostProcessor>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="token to props" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">// 取到 token 就提升为全局 property：SETUP 线程结束后变量即销毁，
// 但 AI 压测组必须带 Authorization——props 是 JVM 级共享，跨线程组唯一正路。
def t = vars.get("login_token")
if (t != null &amp;&amp; t != "NOTFOUND") {
    props.put("ai_token", t)
    log.info("SETUP: JWT captured into props.ai_token")
} else {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseMessage("login failed: token NOTFOUND — 检查 admin_pass 注入")
}</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
      </hashTree>

      <!-- ========== PRIME：暖 AI 缓存 ==========
           1 线程顺序 30 发：每篇文章的真实调用一次，结果写进 Redis（TTL 7 天，
           AiCacheService）。之后 TG-AI 的全部请求走 fromCache 分支——
           测的是「AI 缓存命中路径的服务端开销」，与厂商时延解耦（答辩口径）。
           同时 PRIME 自身每发都真实调模型：单发时延数据顺带写进 jtl，
           报告里可作为"真实生成一帧摘要的成本"参考项。 -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="PRIME-ai-cache" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">${__P(prime_loops,30)}</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${__P(prime_threads,1)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
      </ThreadGroup>
      <hashTree>
        <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="ai bodies (ordered)" enabled="true">
          <stringProp name="delimiter">,</stringProp>
          <stringProp name="fileEncoding">UTF-8</stringProp>
          <stringProp name="filename">${__P(ai_csv,ai_bodies.csv)}</stringProp>
          <boolProp name="ignoreFirstLine">true</boolProp>
          <boolProp name="randomOrder">false</boolProp>
          <boolProp name="recycle">true</boolProp>
          <stringProp name="stopThread">false</stringProp>
          <stringProp name="variableNames">aifile</stringProp>
        </CSVDataSet>
        <hashTree/>
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="load ai body file" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">// Bodies are pre-generated pure-ASCII JSON (CJK as backslash-u escapes):
// Windows JVM file.encoding is unreliable, escaped form is immune (M16 decision).
def dir = new File(props.getProperty("ai_body_dir", "ai_bodies"))
def f = new File(dir, vars.get("aifile"))
vars.put("ai_body", f.getText("UTF-8"))</stringProp>
        </JSR223PreProcessor>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST /api/ai/summary (prime)" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">${ai_body}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
          <stringProp name="HTTPSampler.domain">${__P(host,127.0.0.1)}</stringProp>
          <stringProp name="HTTPSampler.port">${__P(port,8080)}</stringProp>
          <stringProp name="HTTPSampler.protocol">${__P(proto,http)}</stringProp>
          <stringProp name="HTTPSampler.path">/api/ai/summary</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <stringProp name="HTTPSampler.connect_timeout">5000</stringProp>
          <stringProp name="HTTPSampler.response_timeout">60000</stringProp>
        </HTTPSamplerProxy>
        <hashTree>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="auth" enabled="true">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Authorization</stringProp>
                <stringProp name="Header.value">Bearer ${__P(ai_token,INVALID)}</stringProp>
              </elementProp>
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Content-Type</stringProp>
                <stringProp name="Header.value">application/json</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="assert code=0" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="0">&quot;code&quot;:0</stringProp>
            </collectionProp>
            <stringProp name="Assertion.test_type">16</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
          </ResponseAssertion>
          <hashTree/>
        </hashTree>
      </hashTree>

      <!-- ========== 场景①：列表 200 并发 ==========
           同参查询命中 blog:list:{md5} 缓存（M9 Cache-Aside），DB 压力≈0，
           测的是 Nginx→Tomcat→Redis→序列化全链路的吞吐上限。
           断言 HTTP 200 且信封 code=0 —— "错误率 0" 的判据。 -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="TG-LIST" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">-1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${__P(list_threads,0)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(list_ramp,10)}</stringProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.duration">${__P(list_duration,300)}</stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
      </ThreadGroup>
      <hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET /api/articles" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
          <stringProp name="HTTPSampler.domain">${__P(host,127.0.0.1)}</stringProp>
          <stringProp name="HTTPSampler.port">${__P(port,8080)}</stringProp>
          <stringProp name="HTTPSampler.protocol">${__P(proto,http)}</stringProp>
          <stringProp name="HTTPSampler.path">/api/articles?page=${__P(page,1)}&amp;size=${__P(size,10)}</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          <stringProp name="HTTPSampler.connect_timeout">5000</stringProp>
          <stringProp name="HTTPSampler.response_timeout">30000</stringProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="assert code=0" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="0">&quot;code&quot;:0</stringProp>
            </collectionProp>
            <stringProp name="Assertion.test_type">16</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
          </ResponseAssertion>
          <hashTree/>
        </hashTree>
      </hashTree>

      <!-- ========== 场景②：详情 200 并发（随机轮播 30 篇样本） ==========
           __Random 在 30 个键间轮播：首轮 miss 打 DB，之后全命中 blog:article:{id}，
           模拟热点集内的真实读路径。断言 code=0。 -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="TG-DETAIL" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">-1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${__P(detail_threads,0)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(detail_ramp,10)}</stringProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.duration">${__P(detail_duration,300)}</stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
      </ThreadGroup>
      <hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET /api/articles/{id}" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
          <stringProp name="HTTPSampler.domain">${__P(host,127.0.0.1)}</stringProp>
          <stringProp name="HTTPSampler.port">${__P(port,8080)}</stringProp>
          <stringProp name="HTTPSampler.protocol">${__P(proto,http)}</stringProp>
          <stringProp name="HTTPSampler.path">/api/articles/${__Random(${__P(id_min,1)},${__P(id_max,30)})}</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          <stringProp name="HTTPSampler.connect_timeout">5000</stringProp>
          <stringProp name="HTTPSampler.response_timeout">30000</stringProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="assert code=0" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="0">&quot;code&quot;:0</stringProp>
            </collectionProp>
            <stringProp name="Assertion.test_type">16</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
          </ResponseAssertion>
          <hashTree/>
        </hashTree>
      </hashTree>

      <!-- ========== 场景③：AI 摘要 20 并发（全缓存命中） ==========
           20 是《部署与测试.md》§2 的口径；PRIME 之后 30 个体都已在缓存，
           本组测 fromCache 分支（哈希→GET→反序列化→记账）的服务端开销。 -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="TG-AI" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">-1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${__P(ai_threads,0)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(ai_ramp,5)}</stringProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.duration">${__P(ai_duration,120)}</stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
      </ThreadGroup>
      <hashTree>
        <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="ai bodies (random)" enabled="true">
          <stringProp name="delimiter">,</stringProp>
          <stringProp name="fileEncoding">UTF-8</stringProp>
          <stringProp name="filename">${__P(ai_csv,ai_bodies.csv)}</stringProp>
          <boolProp name="ignoreFirstLine">true</boolProp>
          <boolProp name="randomOrder">true</boolProp>
          <boolProp name="recycle">true</boolProp>
          <stringProp name="stopThread">false</stringProp>
          <stringProp name="variableNames">aifile</stringProp>
        </CSVDataSet>
        <hashTree/>
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="load ai body file" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">def dir = new File(props.getProperty("ai_body_dir", "ai_bodies"))
def f = new File(dir, vars.get("aifile"))
vars.put("ai_body", f.getText("UTF-8"))</stringProp>
        </JSR223PreProcessor>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST /api/ai/summary" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">${ai_body}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
          <stringProp name="HTTPSampler.domain">${__P(host,127.0.0.1)}</stringProp>
          <stringProp name="HTTPSampler.port">${__P(port,8080)}</stringProp>
          <stringProp name="HTTPSampler.protocol">${__P(proto,http)}</stringProp>
          <stringProp name="HTTPSampler.path">/api/ai/summary</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <stringProp name="HTTPSampler.connect_timeout">5000</stringProp>
          <stringProp name="HTTPSampler.response_timeout">60000</stringProp>
        </HTTPSamplerProxy>
        <hashTree>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="auth" enabled="true">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Authorization</stringProp>
                <stringProp name="Header.value">Bearer ${__P(ai_token,INVALID)}</stringProp>
              </elementProp>
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Content-Type</stringProp>
                <stringProp name="Header.value">application/json</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="assert code=0" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="0">&quot;code&quot;:0</stringProp>
            </collectionProp>
            <stringProp name="Assertion.test_type">16</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
          </ResponseAssertion>
          <hashTree/>
        </hashTree>
      </hashTree>

      <!-- ========== 场景④：AI 降级路径 500 并发 ==========
           前置：runner 已把 sys_config.ai_enabled 置 false（一键熔断，R-03 应急口）。
           assertEnabled() 是管道第一闸——在读正文/查默认配置/解密 Key 之前抛
           4004，预期亚 10ms。BizException(4004) 走默认 HTTP 200（细分靠 code，
           BizException 构造缺省 200），断言只认信封 "code":4004：
           JMeter 默认不因非 2xx 判失败，判定完全交给这条断言。
           loops 限 10（500×10=5000 发）而非定时长：纯 4004 循环极快，
           5min 会产生几十万条记账日志污染 ai_call_log。 -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="TG-AI-DEGRADED" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">${__P(deg_loops,10)}</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${__P(deg_threads,0)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(deg_ramp,15)}</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
      </ThreadGroup>
      <hashTree>
        <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="ai bodies (random)" enabled="true">
          <stringProp name="delimiter">,</stringProp>
          <stringProp name="fileEncoding">UTF-8</stringProp>
          <stringProp name="filename">${__P(ai_csv,ai_bodies.csv)}</stringProp>
          <boolProp name="ignoreFirstLine">true</boolProp>
          <boolProp name="randomOrder">true</boolProp>
          <boolProp name="recycle">true</boolProp>
          <stringProp name="stopThread">false</stringProp>
          <stringProp name="variableNames">aifile</stringProp>
        </CSVDataSet>
        <hashTree/>
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="load ai body file" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">def dir = new File(props.getProperty("ai_body_dir", "ai_bodies"))
def f = new File(dir, vars.get("aifile"))
vars.put("ai_body", f.getText("UTF-8"))</stringProp>
        </JSR223PreProcessor>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST /api/ai/summary (degraded)" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">${ai_body}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
          <stringProp name="HTTPSampler.domain">${__P(host,127.0.0.1)}</stringProp>
          <stringProp name="HTTPSampler.port">${__P(port,8080)}</stringProp>
          <stringProp name="HTTPSampler.protocol">${__P(proto,http)}</stringProp>
          <stringProp name="HTTPSampler.path">/api/ai/summary</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <stringProp name="HTTPSampler.connect_timeout">5000</stringProp>
          <stringProp name="HTTPSampler.response_timeout">30000</stringProp>
        </HTTPSamplerProxy>
        <hashTree>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="auth" enabled="true">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Authorization</stringProp>
                <stringProp name="Header.value">Bearer ${__P(ai_token,INVALID)}</stringProp>
              </elementProp>
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Content-Type</stringProp>
                <stringProp name="Header.value">application/json</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="assert code=4004" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="0">&quot;code&quot;:4004</stringProp>
            </collectionProp>
            <stringProp name="Assertion.test_type">16</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
          </ResponseAssertion>
          <hashTree/>
        </hashTree>
      </hashTree>

