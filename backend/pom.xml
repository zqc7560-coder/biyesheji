<?xml version="1.0" encoding="UTF-8"?>
<!--
  个人博客系统 · 后端工程 POM（M0 工程骨架）
  ============================================================
  设计依据：《系统设计.md》§4 技术选型 —— Spring Boot 3.2 + MyBatis-Plus + Redis + Knife4j。
  说明：
  1. 编译目标 Java 17（与设计文档选型一致），本机 JDK 21 向下兼容编译。
  2. MyBatis-Plus 使用 spring-boot3 专用 starter（3.5.x），包名 jakarta 与 Boot3 匹配。
  3. 测试数据源用 H2 内存库（MySQL 兼容模式），见 src/test/resources/application-test.yml，
     单测不依赖本机 MySQL 账号口令（进度台账环境约束）。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Spring Boot 官方父 POM：统一管理依赖版本，避免手工对齐 starter 版本 -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.2.5</version>
    <relativePath/>
  </parent>

  <groupId>com.blog</groupId>
  <artifactId>blog-server</artifactId>
  <version>0.1.0</version>
  <name>blog-server</name>
  <description>个人博客系统后端（毕业设计）</description>

  <properties>
    <java.version>17</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <mybatis-plus.version>3.5.5</mybatis-plus.version>
    <knife4j.version>4.5.0</knife4j.version>
    <jjwt.version>0.12.5</jjwt.version>
    <!--
      JaCoCo 落盘路径的坑（M11 固化）见下方 coverage-ascii-exec profile 注释；
      这里保持 Maven 默认（target/jacoco.exec），CI/Linux 直接用。
    -->
  </properties>

  <dependencies>
    <!-- Web：REST 控制器、内嵌 Tomcat、Jackson —— 所有 HTTP 接口的基座 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Validation：@Valid/@NotBlank 等注解校验，配合全局异常处理器返回 400 字段明细 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- 数据访问：MyBatis-Plus（分页/逻辑删除/乐观锁插件，见《系统设计.md》§4 选型理由） -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
      <version>${mybatis-plus.version}</version>
    </dependency>

    <!-- MySQL 驱动：仅运行时使用；测试环境切换为 H2 -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Redis：缓存体系 / Token 黑名单 / AI 配额计数（《数据库设计.md》§4 键空间设计） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>

    <!-- Spring Security（M2 认证）：只提供 BCrypt + 过滤器链 + @PreAuthorize 鉴权，
         不使用其表单登录/Session 能力（无状态 JWT 方案，《系统设计.md》§4 选型） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <!-- JWT（M2）：jjwt 0.12.x —— 0.11→0.12 API 有迁移成本（parserBuilder→Jwts.parser 等），
         项目计划 D-6 已预研：统一用 0.12 新 API，密钥 HS256 ≥32 字节 -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>${jjwt.version}</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>

    <!-- jsoup（M3）：Markdown 正文服务端清洗与纯文本抽取（WBS 1.4.3 / NFR-05 双防线的第一道）。
         版本不受 Boot parent 管理，显式钉 1.17.2：其 text() 不收集 script/style 内容、
         clean(Safelist.none()) 会先解码 HTML 实体再剥离标签，能拦住实体混淆绕过 -->
    <dependency>
      <groupId>org.jsoup</groupId>
      <artifactId>jsoup</artifactId>
      <version>1.17.2</version>
    </dependency>

    <!-- Lombok：精简实体样板代码（@Data/@Builder），编译期生效不进产物 -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- Knife4j（基于 springdoc-openapi）：在线接口文档，答辩演示可直接调试；
         prod profile 下通过 knife4j.enabled=false 关闭（《部署与测试.md》§1.1） -->
    <dependency>
      <groupId>com.github.xiaoymin</groupId>
      <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
      <version>${knife4j.version}</version>
    </dependency>

    <!-- ==================== 测试依赖 ==================== -->
    <!-- JUnit5 + Mockito + AssertJ + MockMvc（Spring Boot Test 全家桶） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- H2 内存库：以 MySQL 兼容模式作为测试数据源，实现"测试不碰真实 MySQL"的环境约束 -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>blog-server</finalName>
    <plugins>
      <!--
        JaCoCo 覆盖率采集（M11 测试完善）——《部署与测试.md》§2 测试策略要求
        "核心 Service 行覆盖 ≥60%、AI 管道 ≥75%"，验收清单 §5 要求附 JaCoCo 报告。
        绑定策略：
        1. prepare-agent 挂在默认构建里 → `mvn test` 自动产出 target/site/jacoco 报告，
           本地与 CI 用同一条命令即可生成，不需要额外 profile（防"忘记开报告"的口径漂移）。
        2. check 规则**不在默认构建里执行**：覆盖率门槛通过 `-Pcoverage-gate` 显式触发
           （verify 阶段），这样日常 `mvn test` 快跑不误伤，CI/里程碑验收才强制门槛。
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.12</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals><goal>report</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!-- 打包时排除 Lombok：它只在编译期起作用，避免进 fat-jar -->
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      coverage-ascii-exec：仅 Windows 激活（本机 OS=Windows 11）。
      背景（M11 实测坑）：工程位于 D:\毕业设计（含中文）。JaCoCo 默认
      destfile=${project.build.directory}/jacoco.exec 展开为中文绝对路径后写进
      surefire fork JVM 的 -javaagent 参数，Windows 命令行编码往返会把路径写坏，
      agent 静默失效——exec 文件永远不生成且不报任何错（日志只有一句
      "Skipping JaCoCo execution due to missing execution data file"，极具迷惑性）。
      对策：Windows 下把 exec 数据重定向到纯 ASCII 的 E 盘目录（E 盘是本工程
      既有的工具盘：Maven 仓库/npm 缓存都在那里，不新增 C 盘占用）。
      Linux（CI ubuntu runner）工程路径无中文，profile 不激活，走默认 target。
    -->
    <profile>
      <id>coverage-ascii-exec</id>
      <activation>
        <os><family>Windows</family></os>
      </activation>
      <properties>
        <!-- prepare-agent 认 jacoco.destFile、report 认 jacoco.dataFile：
             两个属性名都必须显式对齐，写漏一个就"记了数据没人读/读了没人记" -->
        <jacoco.destFile>E:/develop/jacoco/blog-server.exec</jacoco.destFile>
        <jacoco.dataFile>E:/develop/jacoco/blog-server.exec</jacoco.dataFile>
      </properties>
    </profile>

    <!--
      coverage-gate：覆盖率门槛（-Pcoverage-gate 显式触发，绑定 verify 阶段）。
      门槛值以《部署与测试.md》§2 为准：核心 Service 行覆盖 ≥60%、AI 管道 ≥75%。
      实测基线（M11 收口时点）：全工程行覆盖 90.0%、AI 包 88.7%、Service/Util/Job
      聚合 91.5%——门槛设在文档要求值（60/75）而不是实测值，理由：文档是验收口径，
      实测值随重构漂移；门槛设高会在无关改动时误伤门禁，设文档值让"退化到低于
      验收线"才亮红。规则用 PACKAGE 级 BUNDLE 计数器 LINE COVEREDRATIO。
    -->
    <profile>
      <id>coverage-gate</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>gate</id>
                <phase>verify</phase>
                <goals><goal>check</goal></goals>
                <configuration>
                  <rules>
                    <rule>
                      <element>BUNDLE</element>
                      <limits>
                        <!-- 全工程行覆盖下限 60%（文档核心 Service 口径的全局化保守版） -->
                        <limit>
                          <counter>LINE</counter>
                          <value>COVEREDRATIO</value>
                          <minimum>0.60</minimum>
                        </limit>
                      </limits>
                    </rule>
                    <rule>
                      <!-- AI 管道包：文档单独要求 ≥75%（课题重点模块的质量红线） -->
                      <element>PACKAGE</element>
                      <includes>
                        <include>com.blog.module.ai.*</include>
                      </includes>
                      <limits>
                        <limit>
                          <counter>LINE</counter>
                          <value>COVEREDRATIO</value>
                          <minimum>0.75</minimum>
                        </limit>
                      </limits>
                    </rule>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
