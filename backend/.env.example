# =====================================================================
# 后端本地环境变量示例 —— 复制为 .env.local（或 IDE 运行配置注入）后填真值。
# 本文件只有占位与说明，绝不包含真实密钥（NFR-04：主密钥不入 git）。
# 生产环境经 docker compose 的 env_file: .env 注入（《部署与测试.md》§1.4）。
# =====================================================================

# --- MySQL（本机 127.0.0.1:3306，服务运行中） ---
BLOG_DB_URL=jdbc:mysql://127.0.0.1:3306/blog_db?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
BLOG_DB_USERNAME=root
BLOG_DB_PASSWORD=

*** --- Redis（本机 127.0.0.1:6379，无密码） ---
BLOG_REDIS_HOST=127.0.0.1
BLOG_REDIS_PASSWORD=

*** --- JWT 签名密钥：≥32 字节随机串；prod 用 openssl rand -hex 32 生成 ---
BLOG_JWT_SECRET=

*** --- AI 主密钥（AES-256-GCM 加密 ai_config.api_key_cipher 用）：prod 必填 ---
*** 丢失即所有已存 Key 无法解密（风险 R-06），上线前离线备份一份
BLOG_AI_MASTER_KEY=

*** --- 上传目录（默认 ./uploads，容器内挂卷 /app/uploads） ---
BLOG_UPLOAD_DIR=./uploads
